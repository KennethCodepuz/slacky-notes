<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MyApp.SlackyNotes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MyApp.Models"
    mc:Ignorable="d"
    Title="SlackyNotes">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="#FFC5D3" BorderThickness="0" BorderBrush="Transparent">
        <ListView x:Name="NotesListView" ItemsSource="{x:Bind ViewModel.Notes}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Note">
                    <Border BorderThickness="0" Margin="5" Padding="10">
                        <StackPanel>
                            <CheckBox IsChecked="False" Content="Mark as Complete"/>
                            <TextBlock Text="{x:Bind Text}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="{x:Bind Status}" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{x:Bind CreatedAt}" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
